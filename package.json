{
  "name": "game-cart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D browser-based kart racing game with local co-op",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config tools/vitest.config.ts",
    "lint": "npm run lint:eslint && npm run lint:md",
    "lint:eslint": "eslint --config tools/eslint.config.js .",
    "lint:md": "markdownlint-cli2 --config tools/.markdownlint.json \"**/*.md\" \"#node_modules/**\" \"#dist/**\"",
    "lint:secrets": "secretlint --secretlintrc tools/.secretlintrc.json \"**/*\"",
    "lint:fix": "eslint --config tools/eslint.config.js --fix . && markdownlint-cli2 --config tools/.markdownlint.json --fix \"**/*.md\" \"#node_modules/**\" \"#dist/**\"",
    "format": "prettier --config tools/.prettierrc --ignore-path tools/.prettierignore --check .",
    "format:write": "prettier --config tools/.prettierrc --ignore-path tools/.prettierignore --write .",
    "setup": "git config core.hooksPath .githook && chmod +x .githook/pre-commit .githook/commit-msg .githook/pre-commit.d/*.sh && echo 'hooks -> .githook (run once after clone)'"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@types/three": "^0.169.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^25.0.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.4",
    "secretlint": "^13.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.0.16",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
