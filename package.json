{
  "name": "game-cart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D browser-based kart racing game with local co-op",
  "scripts": {
    "agent:ctx": "node tools/agent-context.mjs ctx",
    "agent:state": "node tools/agent-context.mjs state",
    "agent:changed": "node tools/agent-context.mjs changed",
    "agent:handoff": "node tools/agent-context.mjs handoff",
    "agent:pr": "node tools/agent-context.mjs pr",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config tools/vitest.config.ts --maxWorkers=4",
    "lint": "npm run lint:eslint && npm run lint:md && npm run lint:okf",
    "lint:eslint": "eslint --config tools/eslint.config.js .",
    "lint:md": "markdownlint-cli2 --config tools/.markdownlint.json \"**/*.md\" \"#node_modules/**\" \"#dist/**\"",
    "lint:okf": "node tools/okf-lint.mjs docs/knowledge",
    "lint:knowledge-sync": "bash tools/check-knowledge-sync.sh --staged",
    "lint:repo": "bash tools/check-repo-rules.sh",
    "lint:secrets": "secretlint --secretlintrc tools/.secretlintrc.json \"**/*\"",
    "lint:fix": "eslint --config tools/eslint.config.js --fix . && markdownlint-cli2 --config tools/.markdownlint.json --fix \"**/*.md\" \"#node_modules/**\" \"#dist/**\"",
    "format": "prettier --config tools/.prettierrc --ignore-path tools/.prettierignore --check .",
    "format:write": "prettier --config tools/.prettierrc --ignore-path tools/.prettierignore --write .",
    "verify": "node tools/verify.mjs full",
    "verify:changed": "node tools/verify.mjs changed",
    "verify:staged": "node tools/verify.mjs staged",
    "verify:push": "node tools/verify.mjs push",
    "verify:ci": "node tools/verify.mjs ci",
    "backlog:check": "node tools/backlog.mjs check",
    "backlog:list": "node tools/backlog.mjs list",
    "backlog:next": "node tools/backlog.mjs next",
    "setup": "git config core.hooksPath .githook && chmod +x .githook/pre-commit .githook/pre-push .githook/commit-msg .githook/pre-commit.d/*.sh && echo 'hooks -> .githook (run once after clone)'"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@types/three": "^0.184.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "js-yaml": "^4.3.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.4",
    "secretlint": "^13.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
